(:JIQS: ShouldRun; Output="true" :)
(: Exact values beyond long limits, including ranges that cross those limits. :)
deep-equal(1000000000000000000000 to 1000000000000000000003,
  (1000000000000000000000, 1000000000000000000001, 1000000000000000000002, 1000000000000000000003))
and deep-equal(-1000000000000000000003 to -1000000000000000000000,
  (-1000000000000000000003, -1000000000000000000002, -1000000000000000000001, -1000000000000000000000))
and deep-equal(9223372036854775806 to 9223372036854775809,
  (9223372036854775806, 9223372036854775807, 9223372036854775808, 9223372036854775809))
and deep-equal(-9223372036854775809 to -9223372036854775806,
  (-9223372036854775809, -9223372036854775808, -9223372036854775807, -9223372036854775806))
and deep-equal(reverse(1000000000000000000000 to 1000000000000000000003),
  (1000000000000000000003, 1000000000000000000002, 1000000000000000000001, 1000000000000000000000))
and subsequence(1000000000000000000000 to 1000000000000000000003, 2, 1) eq 1000000000000000000001
and deep-equal(subsequence(9223372036854775805 to 9223372036854775807, 1),
  (9223372036854775805, 9223372036854775806, 9223372036854775807))
and empty(subsequence(9223372036854775805 to 9223372036854775807, 1, 0))
